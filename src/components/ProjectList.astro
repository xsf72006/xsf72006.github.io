---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'projects'>[];
}

const { entries } = Astro.props;
---

<ul class="proj">
  {
    entries.map(({ data }) => (
      <li>
        <h3 class="proj-title"><a href={data.url}>{data.title}</a></h3>
        <p class="proj-desc">{data.description}</p>
        <div class="proj-meta">
          <span>{data.year} · {data.stack}</span>
          <span>
            {/* 'live' is the unremarkable case, so only 'archived' is stated. */}
            {data.status === 'live' ? '' : `${data.status} · `}
            <a href={data.repo}>source</a>
          </span>
        </div>
      </li>
    ))
  }
</ul>
